{
    "name": "jpeters8889/journey-tracker-laravel",
    "type": "library",
  "version": "0.4.0",
    "require": {
        "php" : "^8.3",
        "laravel/framework": "^12.0",
        "spatie/laravel-package-tools": "^1.92"
    },
    "autoload": {
        "psr-4": {
            "Jpeters8889\\JourneyTrackerLaravel\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Jamie Peters",
            "email": "jamie@jamie-peters.co.uk"
        }
    ],
  "extra": {
    "laravel": {
      "providers": [
        "Jpeters8889\\JourneyTrackerLaravel\\JourneyTrackerServiceProvider"
      ],
      "aliases": {
        "JourneyTracker": "Jpeters8889\\JourneyTrackerLaravel\\Facades\\JourneyTracker"
      }
    }
  },
    "require-dev": {
        "pestphp/pest": "*",
        "pestphp/pest-plugin-laravel": "*",
        "orchestra/testbench": "*"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
