{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "jpeters8889/journey-tracker-laravel",
    "type": "library",
    "description": "Server-side Laravel SDK for journey-tracker.cloud: automatic page view tracking, custom events, journey tagging, and a fluent query builder for the data you collect.",
    "keywords": [
        "laravel",
        "analytics",
        "journey-tracker",
        "page-views",
        "tracking",
        "sdk"
    ],
    "homepage": "https://journey-tracker.cloud",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^12.61|^13.23",
        "spatie/laravel-package-tools": "^1.92"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.5",
        "larastan/larastan": "^3.10.0",
        "laravel/pint": "^1.30.5",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^5.1.1",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "pestphp/pest-plugin-phpstan": "^5.2",
        "pestphp/pest-plugin-rector": "^5.0.4",
        "pestphp/pest-plugin-type-coverage": "^5.0.2",
        "rector/rector": "^2.6.3"
    },
    "autoload": {
        "psr-4": {
            "Jpeters8889\\JourneyTrackerLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "support": {
        "issues": "https://github.com/jpeters8889/journey-tracker-laravel/issues",
        "source": "https://github.com/jpeters8889/journey-tracker-laravel"
    },
    "authors": [
        {
            "name": "Jamie Peters",
            "email": "jamie@jamie-peters.co.uk"
        }
    ],
    "scripts": {
        "phpstan": "@composer run stan",
        "stan": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/phpstan analyse --memory-limit 4048M"
        ],
        "pint": "vendor/bin/pint",
        "test": "vendor/bin/pest",
        "type-coverage": [
            "php -d memory_limit=-1 ./vendor/bin/pest --type-coverage --min=100"
        ],
        "coverage": [
            "php -d memory_limit=-1 ./vendor/bin/pest --coverage --min=100"
        ],
        "rector": [
            "vendor/bin/rector process"
        ],
        "rector-dry": [
            "vendor/bin/rector process --dry-run"
        ],
        "pre-commit": [
            "Composer\\Config::disableProcessTimeout",
            "composer run rector-dry",
            "composer run pint",
            "composer run stan",
            "composer run type-coverage",
            "composer run test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jpeters8889\\JourneyTrackerLaravel\\JourneyTrackerServiceProvider"
            ],
            "aliases": {
                "JourneyTracker": "Jpeters8889\\JourneyTrackerLaravel\\Facades\\JourneyTracker"
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
